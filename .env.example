# -----------------------------------------------------------------------------
# Variables de entorno locales para este proyecto.
# Este archivo no debe subirse al repositorio con credenciales reales.
# Copialo como .env para levantar el Switch en local.
# -----------------------------------------------------------------------------

# Nombre del driver JDBC usado por Spring Boot para conectarse a PostgreSQL.
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# URL JDBC completa de la base de datos del Switch.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/banquito_switch
SPRING_DATASOURCE_USERNAME=devep1
SPRING_DATASOURCE_PASSWORD=banbanquito2

# Lista de origenes permitidos para CORS, separados por comas.
SWITCH_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# URL base del Core Bancario para la integracion REST.
CORE_BASE_URL=http://34.27.240.236:8081

# Codigo funcional del subtipo de pago masivo configurado en el Core.
CORE_INTEGRATION_CODIGO_SUBTIPO_PAGO_MASIVO=PAGO_MASIVO

# Codigo contable de la cuenta de ingresos del servicio en el Core.
CORE_INTEGRATION_CODIGO_CUENTA_INGRESOS=INGRESOS_SERVICIOS_MASIVOS

# Codigo contable de la cuenta de IVA del servicio en el Core.
CORE_INTEGRATION_CODIGO_CUENTA_IVA=PASIVOS_IVA_RETENIDO

# Numero de cuenta contable o logica para ingresos del servicio.
CORE_INTEGRATION_NUMERO_CUENTA_INGRESOS=9000000001

# Numero de cuenta contable o logica para IVA del servicio.
CORE_INTEGRATION_NUMERO_CUENTA_IVA=9000000002

# Hora de corte operativa para demo. Si queda vacia, se usa PARAMETRO_SWITCH.
# Formato HH:mm, por ejemplo 18:00.
SWITCH_PARAMETROS_HORA_CORTE_PROCESO=

# Hora de inicio de procesamiento para lotes encolados. Si queda vacia, se usa PARAMETRO_SWITCH.
# Formato HH:mm, por ejemplo 08:00.
SWITCH_PARAMETROS_HORA_INICIO_LOTES_ENCOLADOS=

# Habilita el scheduler que procesa lotes encolados automaticamente.
SWITCH_COLA_SCHEDULER_ENABLED=true

# Tiempo en milisegundos entre ejecuciones del scheduler de cola.
SWITCH_COLA_SCHEDULER_FIXED_DELAY_MS=60000

# Numero maximo de lotes a procesar por ciclo del scheduler de cola.
SWITCH_COLA_MAX_LOTES_POR_CICLO=10

# Minutos que espera el sistema antes de reintentar un lote fallido.
SWITCH_COLA_REINTENTO_DELAY_MINUTOS=5

# Habilita el servidor SFTP embebido para carga de archivos.
SWITCH_SFTP_ENABLED=true

# Host o interfaz de red donde escuchara el servidor SFTP.
SWITCH_SFTP_HOST=0.0.0.0

# Puerto TCP del servidor SFTP embebido.
SWITCH_SFTP_PORT=2222

# Ruta del directorio raiz donde llegaran los archivos SFTP.
SWITCH_SFTP_ROOT_DIRECTORY=sftp-inbox

# Tiempo en milisegundos entre escaneos del inbox SFTP.
SWITCH_SFTP_SCAN_FIXED_DELAY_MS=10000

# Tiempo minimo en milisegundos para considerar estable un archivo antes de procesarlo.
SWITCH_SFTP_FILE_SETTLE_MS=3000

# Si es true, la aplicacion termina el arranque cuando el SFTP falla.
SWITCH_SFTP_FAIL_ON_START_ERROR=false

# Host del servidor SMTP para envio de notificaciones.
SPRING_MAIL_HOST=34.27.240.236

# Puerto del servidor SMTP.
SPRING_MAIL_PORT=1025

# Usuario SMTP; dejar vacio si no aplica.
SPRING_MAIL_USERNAME=

# Contrasena SMTP; dejar vacio si no aplica.
SPRING_MAIL_PASSWORD=

# Indica si el servidor SMTP requiere autenticacion.
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false

# Indica si el servidor SMTP usa STARTTLS.
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# Correo remitente usado por las notificaciones a beneficiarios.
SPRING_MAIL_FROM=notificaciones@banquito.com

# URL base de la API de Mailpit usada para pruebas y consulta de mensajes.
MAILPIT_API_URL=http://34.27.240.236:8025/api/v1

