      ]
    },
    {
      "name": "04 Errores con lote y scheduler",
      "description": "Estos archivos si crean lote. El scheduler debe llevarlos a RECHAZADO o FALLIDO segun la etapa donde fallen.",
      "item": [
        {
          "name": "POST Cargar cuenta matriz invalida",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "archivo", "type": "file", "src": "postman/production_examples/prod_lote_error_cuenta_matriz.csv" },
                { "key": "tipoServicio", "value": "{{tipoServicio}}", "type": "text" },
                { "key": "cuentaMatrizCargo", "value": "0010000000999", "type": "text" },
                { "key": "canalIngreso", "value": "PORTAL_WEB", "type": "text" },
                { "key": "rucEmpresa", "value": "{{rucEmpresa}}", "type": "text" },
                { "key": "idCredencialWebCore", "value": "{{idCredencialWebCore}}", "type": "text" },
                { "key": "usernameCredencialWebCore", "value": "{{usernameCredencialWebCore}}", "type": "text" }
              ]
            },
            "url": { "raw": "{{apiBase}}/lotes", "host": ["{{apiBase}}"], "path": ["lotes"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lote creado', function () { pm.response.to.have.status(201); const json = pm.response.json(); pm.collectionVariables.set('uuidLoteCuentaMatrizError', json.uuidLote); });"
                ]
